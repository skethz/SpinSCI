{
  "model": {
    "type": "SpinSCI",
    "color_channels": 1,
    "dim": 64,
    "frames": 10,
    "blocks": 9,
    "num_heads": 4,
    "window": 7,
    "pooled_window": 8,
    "head_pools": [
      1,
      1,
      2,
      4
    ],
    "ffn_ratio": 2,
    "stem_rank": 32,
    "tail_rank": 32,
    "cond_dim": 3,
    "eps": 1e-08,
    "return_intermediate": false,
    "use_bayer_init": false,
    "conditioning_mode": "backprojection",
    "dc_position": "post",
    "deep_supervision": true,
    "aux_after": [
      3,
      6
    ],
    "ffn_impl": "cudnn",
    "fp32_io": true,
    "ising_cfg": {
      "enable": true,
      "space_enable": true,
      "time_enable": true,
      "K": 3,
      "beta": 1.0,
      "gamma": 1.0,
      "signed": true,
      "symmetric": true,
      "topk": 0,
      "gate_scale": 1.0,
      "refine_hidden": 64,
      "cond_dim": 3,
      "cond_in_h": true,
      "cond_in_J": true,
      "lambda_mask": 1.0,
      "lambda_res": 1.0,
      "lambda_phis": 0.0,
      "learn_lambda": true,
      "learn_beta": true,
      "learn_gamma": true,
      "learn_gate_scale": true
    }
  }
}
